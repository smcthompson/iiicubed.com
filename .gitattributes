# Auto detect text files and enforce LF normalization
# Default: detect text and ensure LF line endings on checkout
* text=auto eol=lf

# Explicitly enforce LF for common text file types
*.js       text eol=lf
*.jsx      text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.json     text eol=lf
*.css      text eol=lf
*.scss     text eol=lf
*.html     text eol=lf
*.htm      text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.sh       text eol=lf
*.ps1      text eol=lf
Dockerfile text eol=lf
*.bat      text eol=lf
*.cmd      text eol=lf

# Ensure repo meta files use LF
.gitattributes text eol=lf
.editorconfig  text eol=lf

# Mark binary files to avoid normalization
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.tgz   binary
*.7z    binary
*.jar   binary
*.war   binary
*.exe   binary
