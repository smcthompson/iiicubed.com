{
  "name": "iiicubed.com",
  "version": "1.0.0",
  "description": "Professional portfolio site highlighting my work.",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run lint && npm run build:css && tsc",
    "build:css": "sass --quiet-deps src/scss/the-purple-haze.scss public/css/the-purple-haze.min.css",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write && eslint . --ext .js,.ts,.tsx --fix",
    "format:check": "prettier . --check && eslint . --ext .js,.ts,.tsx --max-warnings=0",
    "validate": "npm run format:check && npm run lint",
    "dev": "tsx watch src/server.ts --ignore-watch node_modules --ignore-watch dist",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "start:ci": "node dist/server.js",
    "test": "npx playwright test",
    "test:ci": "npm run test",
    "test:grep": "npm run test -- --grep",
    "workstation:migrate": "tsx src/app/workstation/infrastructure/sqlserver/migrations/runWorkstationMigrations.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smcthompson/iiicubed.com.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "imports": {
    "#/components": "./dist/components/index.js",
    "#/pages": "./dist/pages/index.js",
    "#/partials": "./dist/partials/index.js",
    "#/routes": "./dist/routes/index.js",
    "#/services": "./dist/services/index.js",
    "#/types": "./dist/types/index.js",
    "#/workstation": "./dist/app/workstation/index.js",
    "#/shared": "./dist/app/shared/index.js",
    "#/*": "./dist/*"
  },
  "bugs": {
    "url": "https://github.com/smcthompson/iiicubed.com/issues"
  },
  "homepage": "https://github.com/smcthompson/iiicubed.com#readme",
  "dependencies": {
    "@kitajs/html": "^4.2.13",
    "@azure/identity": "^4.13.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "dotenv": "^17.4.2",
    "mssql": "^9.1.1",
    "express": "^5.2.1",
    "playwright": "^1.61.0",
    "sass": "^1.101.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.0",
    "@types/express": "^5.0.6",
    "@types/mssql": "^7.1.1",
    "@types/node": "^25.9.2",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}